{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "resolveJsonModule": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "web/src", "keeper"]
}

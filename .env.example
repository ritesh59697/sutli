# Keeper (server-side only; the browser reaches RPC through the keeper's /rpc proxy)
MAINNET_RPC=https://your-provider/?api-key=...
DEVNET_RPC=https://your-devnet-provider/?api-key=...
KEEPER_PORT=8797
POLL_MS=15000
ORDERS_FILE=data/orders.json
ALLOWED_ORIGIN=*

# Web (Vite)
VITE_KEEPER_URL=http://localhost:8797
